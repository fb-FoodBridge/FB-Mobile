{
  "expo": {
    "name": "FB-Mobile",
    "slug": "fb-mobile",
    "version": "1.0.0",
    "icon": "./assets/png/Vector.png",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#000000",
      "resizeMode": "contain"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.fbmobile.app",
      "navigationBar": {
        "backgroundColor": "#3D3D3D",
        "barStyle": "light-content"
      },
      "web": {},
      "plugins": [
        "expo-router",
        "expo-font"
      ],
      "scheme": "fb-mobile"
    },
    "plugins": [
      "expo-router"
    ]
  }
}
